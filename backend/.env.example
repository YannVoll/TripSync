# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tripsync"

# Server
PORT=3001
FRONTEND_URL="http://localhost:5173"

# JWT
JWT_SECRET="your-secret-key-here-change-in-production"

# Email Service (Resend SMTP)
# Crie uma chave em https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key"
# O remetente de teste do Resend só pode enviar para o email da sua conta Resend.
# Para outros destinatários, verifique um domínio em https://resend.com/domains
# e informe, por exemplo: EMAIL_FROM="TripSync <avisos@seudominio.com>"
# EMAIL_FROM="TripSync <onboarding@resend.dev>"
RESEND_SMTP_PORT=465

# Weather API
OPENWEATHER_API_KEY="your-openweathermap-api-key"

# Node Environment
NODE_ENV="development"
